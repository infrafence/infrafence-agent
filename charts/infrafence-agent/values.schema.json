{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "apiKey": {
      "type": "string",
      "description": "Cluster key (IFK-...) from the dashboard, Settings → Kubernetes. One key registers every node."
    },
    "serverUrl": {
      "type": "string",
      "description": "InfraFence dashboard URL",
      "default": "https://infrafence.com"
    },
    "clusterName": {
      "type": "string",
      "description": "Cluster name; nodes are grouped by it in the dashboard (detected from the cluster when empty)"
    },
    "nameOverride": {
      "type": "string",
      "description": "Override for the chart name in resource names"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "default": "ghcr.io/infrafence/infrafence-agent"
        },
        "tag": {
          "type": "string",
          "description": "Defaults to appVersion"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["IfNotPresent", "Always", "Never"],
          "default": "Always"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        }
      }
    },
    "tolerations": {
      "type": "array",
      "description": "Pod tolerations — default tolerates all taints"
    },
    "nodeSelector": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "extraEnv": {
      "type": "array",
      "description": "Extra environment variables",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" }
        },
        "required": ["name", "value"]
      }
    },
    "autoUpdate": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Let the agent move its own DaemonSet to a new signed release image when an update is allowed. Disable with GitOps (ArgoCD, Flux).",
          "default": true
        }
      }
    },
    "ingressFirewall": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Create the RBAC for blocking addresses in the nginx-ingress ConfigMap",
          "default": false
        },
        "namespace": {
          "type": "string",
          "default": "ingress-nginx"
        },
        "configMapName": {
          "type": "string",
          "default": "ingress-nginx-controller"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "default": true
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    }
  }
}
