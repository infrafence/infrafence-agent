<model>
    <mount>//OPNsense/infrafence/general</mount>
    <description>InfraFence agent</description>
    <version>0.1.0</version>
    <items>
        <enabled type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </enabled>
        <server_url type="UrlField">
            <Default>https://app.infrafence.com</Default>
            <Required>Y</Required>
        </server_url>
        <!-- The mode sent at registration; afterwards the dashboard is the
             source of truth (Status tab: switch, through the dashboard).
             The install token is never stored here: config.xml goes into
             backups, exports and HA sync. -->
        <mode type="OptionField">
            <Default>monitor</Default>
            <Required>Y</Required>
            <OptionValues>
                <monitor>Learning (detect and report, block nothing)</monitor>
                <protect>Full protection</protect>
            </OptionValues>
        </mode>
        <interfaces type="InterfaceField">
            <Multiple>Y</Multiple>
            <Default>wan</Default>
            <Required>Y</Required>
        </interfaces>
        <blockoutbound type="BooleanField">
            <Default>0</Default>
        </blockoutbound>
        <logblocks type="BooleanField">
            <Default>0</Default>
        </logblocks>
    </items>
</model>
