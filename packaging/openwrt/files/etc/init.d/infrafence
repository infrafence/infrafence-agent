#!/bin/sh /etc/rc.common
# InfraFence router agent (procd). After the firewall and dnsmasq.
START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/infrafence-router

start_service() {
	config_load infrafence
	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	if [ ! -s /etc/infrafence/config.json ]; then
		logger -t infrafence "not registered yet: enrol from LuCI (Services > InfraFence) or run: $PROG register --token <token>"
		return 0
	fi
	procd_open_instance
	procd_set_param command "$PROG" run
	# A 128 MB router: keep the Go heap small and collect early.
	procd_set_param env GOMEMLIMIT=12MiB GOGC=50
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param nice 5
	procd_close_instance
}

# After the agent stopped (stop, disable, package removal): take its rules
# and DNS list out, so a stopped agent never leaves anything behind. Not on
# restart (upgrade, enrolment): the new process takes the rules over, with
# no gap in protection.
service_stopped() {
	[ -n "$INFRAFENCE_RESTARTING" ] && return 0
	"$PROG" cleanup >/dev/null 2>&1
}

restart() {
	INFRAFENCE_RESTARTING=1
	stop "$@"
	INFRAFENCE_RESTARTING=
	start "$@"
}

# reload: the agent re-reads its settings and checks its firewall rules
# (also run by the firewall include after every firewall reload).
reload_service() {
	procd_send_signal infrafence '*' HUP
}

service_triggers() {
	procd_add_reload_trigger "infrafence" "firewall" "dhcp"
	procd_add_interface_trigger "interface.*.up" "wan" /etc/init.d/infrafence reload
}
